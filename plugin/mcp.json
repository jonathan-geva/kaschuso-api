{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kaschuso-grades": {
      "type": "streamable-http",
      "url": "https://kaschuso-api.onrender.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "oidcEnabled": false,
            "baseScopes": ["grades:read"],
            "defaultScopes": ["grades:read"]
          }
        }
      }
    }
  }
}
